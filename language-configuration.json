{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(se\\b.*:|senao\\s*:|repita\\b.*:|if\\b.*:|else\\s*:|repeat\\b.*:|si\\b.*:|sino\\s*:|repetir\\b.*:)",
    "decreaseIndentPattern": "^\\s*(senao\\s*:|else\\s*:|sino\\s*:|fim\\b|end\\b|fin\\b)"
  }
}
