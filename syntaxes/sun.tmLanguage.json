{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sun",
  "scopeName": "source.sun",
  "fileTypes": [
    "sun"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sun",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-dash.sun",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sun",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sun",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sun",
          "match": "\\b(se|senao|if|else|si|sino|repita|repeat|repetir|enquanto|while|mientras|vezes|times|veces|fim|end|fin)\\b"
        },
        {
          "name": "storage.type.sun",
          "match": "\\b(local|let)\\b"
        },
        {
          "name": "keyword.other.sun",
          "match": "\\b(fale|say|decir|mude|set|cambiar|funcao|function|funcion|retorne|return|retornar)\\b"
        },
        {
          "name": "keyword.operator.word.sun",
          "match": "\\bé legítimo\\b|\\b(e|and|ou|or|nao|not)\\b"
        },
        {
          "name": "support.function.builtin.sun",
          "match": "\\\\b(tamanho|length|adicionar|add|remover|remove|contem|contains|numero|number|texto|string|raiz|sqrt|arredondar|round|piso|floor|teto|ceil|absoluto|abs|maximo|maximum|minimo|minimum|aleatorio|random)\\\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sun",
          "match": "\\b(verdadeiro|falso|true|false)\\b"
        },
        {
          "name": "constant.language.null.sun",
          "match": "\\b(nulo|null)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.sun",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.sun",
      "match": "==|!=|>=|<=|[+*/%=<>\\-]"
    },
    "functions": {
      "name": "entity.name.function.sun",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "punctuation": {
      "name": "punctuation.section.sun",
      "match": "[\\[\\](),]"
    }
  }
}
